    {
      "parameters": {
        "jsCode": "const raw =\n  $input.first().json.message?.text ||\n  $input.first().json.output ||\n  $input.first().json.text ||\n  \"\";\n\nlet prioridad = null;\nlet mensaje = \"\";\n\ntry {\n\n  // Convertir string JSON a objeto\n  const parsed = JSON.parse(raw);\n\n  prioridad = parsed.prioridad ?? null;\n  mensaje = parsed.mensaje ?? \"\";\n\n} catch (e) {\n\n  // Fallback por si el modelo devuelve texto raro\n  mensaje = raw;\n\n  const match = raw.match(/\\d+/);\n  if (match) {\n    prioridad = parseInt(match[0]);\n  }\n}\n\nreturn [{\n  json: {\n    respuesta: mensaje,\n    prioridad: prioridad\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
