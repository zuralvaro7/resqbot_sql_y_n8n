    {
      "parameters": {
        "jsCode": "// Obtener el texto de la respuesta del agente\nconst respuesta = $input.first().json.message?.text || \n                  $input.first().json.output || \n                  $input.first().json.text || \"\";\n\n// Extraer el nivel de peligro/prioridad\nlet prioridad = null;\n\n// Buscar patrones como \"Peligro 1\", \"Peligro 2\", \"Peligro 3\"\nconst match = respuesta.match(/Peligro\\s*(\\d+)/gi);\n\nif (match && match.length > 0) {\n  // Tomar el número más alto mencionado como prioridad principal\n  const numeros = match.map(m => parseInt(m.match(/\\d+/)[0]));\n  prioridad = Math.max(...numeros);\n}\n\nreturn [{\n  json: {\n    respuesta: respuesta,\n    prioridad: prioridad\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
